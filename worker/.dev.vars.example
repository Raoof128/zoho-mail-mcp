# Copy to worker/.dev.vars for local development. That file is gitignored and must never be committed.
# Every value here is a throwaway placeholder. Generate real ones before deploying anywhere.

# Encryption keyring for stored Google tokens: a JSON map of key id to 32 raw bytes, base64 encoded.
# Old keys stay in the ring so existing ciphertexts still decrypt while they are re-encrypted lazily.
# Generate one with:  openssl rand -base64 32
TOKEN_KEKS={"k1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}
TOKEN_KEK_CURRENT=k1

# HMAC keys, 32 raw bytes base64. Separate secrets on purpose: approval state and CSRF tokens should
# not be signed with the same key.
STATE_HMAC_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
CSRF_HMAC_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

# Consulted only while OWNER_ZOHO_SUBS is empty: the login page then shows the Zoho sub of anyone whose
# email is listed here, so it can be pasted into OWNER_ZOHO_SUBS.
OWNER_EMAILS=you@example.test

# Zoho (AU data centre). Client from the Zoho API console, Server-based Application. Redirect URIs:
#   https://<WORKER_HOSTNAME>/zoho/login/callback  and  https://<WORKER_HOSTNAME>/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Comma separated Zoho subs allowed to log in; empty enables the bootstrap page.
OWNER_ZOHO_SUBS=
# The two mailbox slots and the addresses they must bind to.
SLOTS={"sarabi":"info@sarabisfinerugs.com.au","rcp":"info@rugcleaningpro.com.au"}
ORG_DOMAINS=sarabisfinerugs.com.au,sarabisfinerugs.com,rugcleaningpro.com.au
