{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoho-mail-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "WORKER_HOSTNAME": "zoho-mail-mcp.example.workers.dev",
    "RECOVERY_PROFILE": "normal",
    "RESTORE_GENERATION": "uninstalled",
  },
  "version_metadata": { "binding": "WORKER_VERSION" },
  "d1_databases": [
    { "binding": "DB", "database_name": "gmail-mcp", "database_id": "local-dev", "migrations_dir": "migrations" },
  ],
  // Dev and tests only: staging/store.ts still uses R2 until M5 Task 5.1 removes it. Production config has no R2.
  "r2_buckets": [{ "binding": "STAGING", "bucket_name": "gmail-mcp-staging" }],
  "durable_objects": { "bindings": [{ "name": "ACCOUNT_DO", "class_name": "AccountDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountDO"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-dev" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
